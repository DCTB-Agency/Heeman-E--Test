---
// Regiopagina "Elektricien in [gemeente]" — CLAUDE.md § 8. Schema: Service met areaServed = deze gemeente.
// Noindex zolang de lokale inhoud (populaire diensten, realisaties, review) nog placeholder is.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import Foto from '../../components/Foto.astro';
import { SITE_URL, business, services, serviceUrl, job } from '../../data/site';
import { dienstTekst } from '../../data/home';
import { regios, regioUrl, afstandVanSchilde, type Regio } from '../../data/regio';
import { realisaties, realisatieUrl } from '../../data/realisaties';
import DienstIcoon from '../../components/DienstIcoon.astro';
import { noindexUrls } from '../../data/noindex';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return regios.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Regio };
const url = regioUrl(r.slug);
const km = afstandVanSchilde(r);
const lokaal = realisaties.filter((x) => x.gemeente === r.naam || r.deelgemeenten.includes(x.gemeente));
const populaireDiensten = r.populair.diensten.map((slug) => services.find((s) => s.slug === slug)!);
const buren = regios.filter((x) => x.slug !== r.slug);
const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: `Elektricien ${r.naam}`, url },
];
const schema = {
  '@type': 'Service',
  '@id': `${SITE_URL}${url}#service`,
  name: `Elektricien in ${r.naam}`,
  serviceType: 'Elektrische installatiewerken',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'City', name: r.naam },
  url: `${SITE_URL}${url}`,
};
---

<Base title={r.metaTitle} description={r.metaDescription} noindex={noindexUrls.has(url)} schema={[schema, breadcrumbSchema(kruimels)]}>
  <section class="container-site grid gap-12 py-12 sm:py-16 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:py-20">
    <div>
      <Kruimels kruimels={kruimels} class="fade-up text-muted" />
      <h1 class="mt-6 text-display">
        <span class="line-mask"><span style="--i:1">Elektricien in</span></span>
        <span class="line-mask"><span style="--i:2" class="text-brand">{r.naam}</span></span>
      </h1>
      <p class="fade-up mt-6 max-w-2xl text-xl leading-relaxed" style="--d:300ms">
        {r.naam === 'Schilde'
          ? <>Mijn zaak is gevestigd in Schilde. Ik ben Bert Heeman, erkend elektricien met {business.experience}, en ik kom zelf langs voor het eerste bezoek en de inschatting.</>
          : <>{r.naam} ligt op ongeveer {km} km van mijn zaak in Schilde (in vogelvlucht). Ik ben Bert Heeman, erkend elektricien met {business.experience}, en ik kom zelf langs voor het eerste bezoek en de inschatting.</>}
      </p>
      {r.deelgemeenten.length > 0 && (
        <p class="fade-up mt-4 text-muted" style="--d:380ms">Ook in {r.deelgemeenten.join(', ').replace(/, ([^,]*)$/, ' en $1')}.</p>
      )}
      <div class="fade-up mt-8 flex flex-wrap gap-3" style="--d:450ms">
        <a href={business.phone.href} class="btn btn-primary" data-event="click_to_call">Bel {business.phone.display}</a>
        <a href="/offerte/" class="btn btn-ghost">Gratis offerte</a>
      </div>
    </div>
    <div class="fade-up self-start rounded-3xl bg-sand/60 p-7" style="--d:350ms">
      <h2 class="font-display text-2xl font-semibold">Veel gevraagd in {r.naam}</h2>
      <p class="mt-3 leading-relaxed">{r.populair.tekst}</p>
      <ul class="mt-5 space-y-2">
        {populaireDiensten.map((s) => (
          <li>
            <a href={serviceUrl(s.slug)} class="group flex items-center gap-3 rounded-2xl bg-white p-3 font-semibold hover:text-brand">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand"><DienstIcoon slug={s.slug} class="size-7" /></span>
              {s.name}
              <span class="ml-auto text-brand" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {(lokaal.length > 0 || r.review) && (
    <section class="section border-t border-ink/10 bg-white/60" aria-labelledby="realisaties">
      <div class="container-site">
        {lokaal.length > 0 && (
          <>
            <h2 id="realisaties" class="h2 reveal">Realisaties in {r.naam}</h2>
            <ul class="mt-8 grid gap-6 md:grid-cols-3">
              {lokaal.map((x) => (
                <li class="reveal">
                  <a href={realisatieUrl(x.slug)} class="group block">
                    <Foto id={x.fotos.hoofd} class="aspect-[4/3]" sizes="(min-width: 768px) 30vw, 100vw" />
                    <p class="mt-3 font-display text-lg font-semibold group-hover:text-brand">{x.titel}</p>
                    <p class="text-sm text-muted">{x.gemeente}</p>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        {r.review && (
          <blockquote class="reveal mt-10 max-w-3xl border-l-4 border-accent pl-6 text-lg">
            <p>“{r.review.tekst}”</p>
            <footer class="mt-2 text-sm text-muted">— {r.review.naam}, Google-review</footer>
          </blockquote>
        )}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="diensten">
    <div class="container-site">
      <h2 id="diensten" class="h2 reveal">Mijn diensten in {r.naam}</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <li class="reveal">
            <a href={serviceUrl(s.slug)} class="group flex h-full flex-col rounded-3xl border border-ink/10 bg-white p-6 hover:border-brand/40">
              <h3 class="font-display text-xl font-semibold group-hover:text-brand">{s.name}</h3>
              <p class="mt-2 flex-1 text-muted">{dienstTekst[s.slug]}</p>
            </a>
          </li>
        ))}
      </ul>
      <div class="reveal mt-12 flex flex-col gap-6 rounded-3xl bg-accent p-8 text-ink sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-2xl font-semibold">Woon je in {r.naam}? Ik zoek een junior elektricien.</p>
        <a href={job.url} class="btn bg-ink text-white hover:bg-ink-soft">Bekijk de vacature</a>
      </div>
      <p class="reveal mt-12 text-sm text-muted">Ook actief in:
        {buren.map((b, i) => <>{i > 0 && ' · '}<a href={regioUrl(b.slug)} class="font-medium text-ink underline-offset-4 hover:text-brand hover:underline">{b.naam}</a></>)}
      </p>
    </div>
  </section>
</Base>
