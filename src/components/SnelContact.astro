---
// Mini-contactformulier in de hero van de homepage (29-10-2026): een "zoekbalk" die de belknop vervangt.
// Zichtbaar: onderwerp + gsm/e-mail + knop. Zodra de bezoeker begint, klapt één extra regel open (naam + privacy).
// Gaat als formulier "snelcontact" naar info@ (Netlify Forms of /formulier.php), bedankpagina = /contact/bedankt/.
import { formAttrs } from '../lib/formulier';
import { antwoordTermijn } from '../data/site';

interface Props {
  class?: string;
  style?: string;
}
const { class: className = '', style } = Astro.props;
const onderwerpen = ['Renovatie of elektriciteitswerken', 'Nieuwbouw', 'Domotica', 'Laadpaal', 'Keuring', 'Herstelling', 'Iets anders'];
---

<form {...formAttrs('snelcontact', '/contact/bedankt/')} class:list={['snelcontact max-w-2xl', className]} style={style} data-event="snelcontact_submit" aria-labelledby="sc-titel">
  <input type="hidden" name="form-name" value="snelcontact" />
  <input type="hidden" name="geladen" value="" data-geladen />
  <p class="hidden" aria-hidden="true"><label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <p id="sc-titel" class="flex items-center gap-2 text-sm font-semibold">
    <span class="sc-lampje" aria-hidden="true"></span>
    Snel een vraag? <span class="font-normal text-muted">We contacteren u binnen {antwoordTermijn}.</span>
  </p>

  <div class="sc-balk mt-3 flex flex-col gap-1.5 rounded-[1.75rem] border-2 border-ink/15 bg-white p-1.5 shadow-[0_18px_40px_-28px_rgb(28_13_10/0.45)] sm:flex-row sm:items-center sm:rounded-full">
    <label for="sc-onderwerp" class="sr-only">Waarover gaat het?</label>
    <select id="sc-onderwerp" name="onderwerp" required class="sc-veld rounded-full bg-paper px-4 py-3 font-semibold text-ink sm:w-56 sm:shrink-0">
      <option value="">Waarover gaat het?</option>
      {onderwerpen.map((o) => <option>{o}</option>)}
    </select>
    <label for="sc-contact" class="sr-only">Uw gsm of e-mail</label>
    <input id="sc-contact" name="contact" required placeholder="Uw gsm of e-mail" autocomplete="on" class="sc-veld min-w-0 flex-1 bg-transparent px-4 py-3 text-ink placeholder:text-muted/80" />
    <button type="submit" class="btn btn-primary shrink-0">
      Contacteer mij
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
  </div>

  <div class="sc-extra mt-3 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <label for="sc-naam" class="sr-only">Uw naam</label>
      <input id="sc-naam" name="naam" required autocomplete="name" placeholder="Uw naam" class="w-full rounded-full border-2 border-ink/15 bg-white px-5 py-2.5 text-ink placeholder:text-muted/80 focus:border-brand focus:outline-none" />
    </div>
    <label class="flex items-start gap-2 text-sm text-muted">
      <input type="checkbox" name="privacy" required class="mt-0.5 size-4 shrink-0 accent-brand" />
      <span>Akkoord met de <a href="/privacy/" class="underline underline-offset-4">privacyverklaring</a></span>
    </label>
  </div>
</form>

<style>
  .sc-balk { transition: border-color 0.2s, box-shadow 0.25s; }
  .sc-balk:focus-within { border-color: var(--color-brand); box-shadow: 0 0 0 4px rgb(190 69 22 / 0.12), 0 18px 40px -28px rgb(28 13 10 / 0.45); }
  .sc-veld:focus { outline: none; }
  select.sc-veld { appearance: none; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 20px) 55%, calc(100% - 15px) 55%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 2.5rem; }

  /* Groen "lampje": er is iemand bereikbaar. */
  .sc-lampje { width: 8px; height: 8px; border-radius: 999px; background: #2fbf71; box-shadow: 0 0 0 0 rgb(47 191 113 / 0.5); }
  @media (prefers-reduced-motion: no-preference) {
    .sc-lampje { animation: sc-puls 2.4s ease-out infinite; }
  }
  @keyframes sc-puls { 0% { box-shadow: 0 0 0 0 rgb(47 191 113 / 0.55); } 70%, 100% { box-shadow: 0 0 0 8px rgb(47 191 113 / 0); } }

  /* Extra regel pas tonen zodra de bezoeker begint (zonder JavaScript: altijd zichtbaar). */
  :global(.js) .snelcontact:not(.open) .sc-extra { display: none; }
  .snelcontact.open .sc-extra { animation: sc-open 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes sc-open { from { opacity: 0; translate: 0 -6px; } to { opacity: 1; translate: none; } }
</style>

<script>
  import '../scripts/bestand-limiet';

  document.querySelectorAll<HTMLFormElement>('form.snelcontact').forEach((form) => {
    const open = () => form.classList.add('open');
    form.addEventListener('focusin', open, { once: true });
    form.addEventListener('input', open, { once: true });

    // Gsm of e-mail: formaat controleren (beide zijn goed).
    const contact = form.querySelector<HTMLInputElement>('#sc-contact')!;
    contact.addEventListener('input', () => {
      const v = contact.value.trim();
      const isMail = v.includes('@') || /[a-z]/i.test(v);
      const ok = !v || (isMail ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) : v.replace(/\D/g, '').length >= 8);
      contact.setCustomValidity(ok ? '' : 'Vul een geldig gsm-nummer of e-mailadres in.');
    });
  });
</script>
