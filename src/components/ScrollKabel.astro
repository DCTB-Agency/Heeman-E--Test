---
// Zwevende kabel uit de header (vervangt de vaste hero-kabel).
// - De kabel hangt aan de onderkant van de (sticky) header; de stekker bengelt vrij in de hero.
// - Hoe verder je scrolt, hoe meer de kabel naar rechts schuift, richting het stopcontact bovenop het
//   volgende blok ([data-kabel-socket]). Komt dat blok bij de stekker, dan steekt die erin: vonk,
//   stroompuls en de klasse `aan` op de zone (voor effecten op het blok zelf).
// - Een veer geeft de stekker gewicht: hij valt bij het laden met een veerkracht naar beneden,
//   schommelt licht en zwiept mee bij snel scrollen.
// - Interactief (muis): over de kabel bewegen tokkelt hem als een snaar; over de stekker bewegen duwt
//   hem weg met een vonk. Ingeplugd rammelt de stekker even in het stopcontact.
// - Mobiel (< 1024 px): kleinere stekker (36 × 40) en stopcontact, korte kabel aan de rechterrand naast de
//   bovenste regel, zodat de titel vrij blijft; tikken op de stekker vervangt de hover.
// - Reduced motion: stilstaand, meteen ingeplugd.
// Plaats dit component als eerste kind van een `relative` wrapper rond de hero én het volgende blok.
---

<div class="scrollkabel pointer-events-none absolute inset-0 z-10" aria-hidden="true">
  <svg class="absolute inset-0 size-full overflow-visible">
    <path class="sk-kabel" fill="none" stroke="var(--color-brand)" stroke-linecap="round" />
    <path class="sk-puls" pathLength="1" fill="none" stroke="#ffd2bd" stroke-linecap="round" />
  </svg>
  <!-- Stekker 36 × 40 px (mobiel) of 54 × 60 px (desktop, × 1,5): pinnen op ± 4 / ± 6 px van het midden,
       exact zoals de gaatjes van .stopcontact-groot (schaal 1 / 1,5). -->
  <svg class="sk-stekker absolute top-0 left-0" viewBox="0 0 36 40">
    <path d="M18 0v10" stroke="var(--color-brand)" stroke-width="4" stroke-linecap="round" />
    <path d="M7 9h22v10a10 10 0 0 1-10 10h-2a10 10 0 0 1-10-10z" fill="var(--color-brand)" />
    <rect x="12.5" y="28" width="3" height="12" rx="1" fill="#8f8581" />
    <rect x="20.5" y="28" width="3" height="12" rx="1" fill="#8f8581" />
    <g class="sk-vonk" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round">
      <path d="M18 44v6M8 41l-5 4M28 41l5 4M4 36H-2M32 36h6" />
    </g>
  </svg>
</div>

<style>
  .sk-kabel { stroke-width: 4; }
  .sk-puls { stroke-width: 5; }
  .sk-stekker {
    width: 36px;
    height: 40px;
    transform-origin: 50% 0;
    will-change: transform;
    overflow: visible;
  }
  @media (min-width: 64rem) {
    .sk-kabel { stroke-width: 6; }
    .sk-puls { stroke-width: 7; }
    .sk-stekker { width: 54px; height: 60px; }
  }
  .sk-puls {
    display: none;
    stroke-dasharray: 0.08 1;
    filter: drop-shadow(0 0 6px #ff5a1f);
  }
  .sk-vonk {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.aan) .sk-puls {
      display: block;
      animation: flow 1.8s linear infinite;
    }
    :global(.aan) .sk-vonk {
      animation: flicker 0.9s ease-out 1;
    }
    .vonk .sk-vonk {
      animation: flicker 0.7s ease-out 1;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.scrollkabel').forEach((el) => {
    const zone = el.parentElement!;
    const header = document.querySelector('header');
    const socket = zone.querySelector<HTMLElement>('[data-kabel-socket]');
    const kabel = el.querySelector<SVGPathElement>('.sk-kabel')!;
    const puls = el.querySelector<SVGPathElement>('.sk-puls')!;
    const stekker = el.querySelector<SVGSVGElement>('.sk-stekker')!;
    if (!header || !socket) return;

    // Toestand van de stekker (bovenkant-midden, in zone-coördinaten) + snelheid.
    let x = NaN, y = NaN, vx = 0, vy = 0;
    // Tokkel: zijwaartse uitwijking van de kabel (wb) en extra kanteling van de stekker (rot), elk met veer.
    let wb = 0, wbv = 0, rot = 0, rotv = 0;
    // Laatst getekende Bézier (voor hit-test met de muis): P0, P1, P2, P3.
    let bez: number[] | null = null;
    let ingeplugd = false;
    let vorige = performance.now();
    let draait = false;

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    // Afmetingen van de stekker volgen de CSS (36 × 40 mobiel, 54 × 60 desktop).
    let PLUG_W = 54, PLUG_H = 60, HALF = 27;
    function maten() {
      const cs = getComputedStyle(stekker);
      PLUG_W = parseFloat(cs.width); PLUG_H = parseFloat(cs.height); HALF = PLUG_W / 2;
    }
    maten();

    function doelen() {
      const zr = zone.getBoundingClientRect();
      const hb = header!.getBoundingClientRect().bottom;
      const sr = socket!.getBoundingClientRect();
      const w = zr.width;
      const socketX = sr.left + sr.width / 2 - zr.left;
      const ingeplugdY = sr.top - zr.top - PLUG_H; // pinnen raken de bovenkant van het stopcontact
      const mobiel = w < 1024;
      // Mobiel: start vlak bij de rechterrand (naast de bovenste regel), desktop: in de lege ruimte rechts van de titel.
      const xs = mobiel ? Math.min(w - 22, socketX + 12) : w * 0.74;

      if (reduce) {
        return { ankerX: socketX, ankerY: 0, tx: socketX, ty: ingeplugdY, plug: true, p: 1, zichtbaar: zr.bottom > 0 };
      }
      const ankerY = hb - zr.top;
      const hangY = ankerY + (mobiel ? 58 : Math.min(innerHeight * 0.42, 340));
      const gap = ingeplugdY - hangY; // wordt kleiner naarmate je scrolt
      const p = clamp(scrollY / Math.max(1, gap + scrollY), 0, 1);
      const plug = gap <= 0;
      const ankerX = xs + (socketX - xs) * p;
      const tx = xs + (socketX - xs) * ease(p);
      return { ankerX, ankerY, tx, ty: plug ? ingeplugdY : hangY, plug, p, zichtbaar: zr.bottom > 0 };
    }

    function frame(nu: number) {
      // Echte verstreken tijd (max. 0,25 s), geïntegreerd in vaste kleine stappen: de veer beweegt even snel
      // op 30, 60 of 120 Hz, en blijft stabiel als de browser frames overslaat.
      const totaal = Math.min(0.25, (nu - vorige) / 1000);
      vorige = nu;
      const d = doelen();

      if (Number.isNaN(x)) {
        x = d.tx;
        y = reduce ? d.ty : d.ankerY - PLUG_H; // start net onder de header: stekker valt naar beneden
      }

      // Veren: stekker (met demping en kleine schommeling als hij vrij hangt), kabel-tokkel en rammel.
      const zwaai = Math.sin(nu / 900) * 5 * (1 - d.p);
      const STAP = 1 / 240;
      for (let t = 0; t < totaal; t += STAP) {
        const dt = Math.min(STAP, totaal - t);
        if (!d.plug) {
          const ax = 140 * (d.tx + zwaai - x) - 11 * vx;
          const ay = 110 * (d.ty - y) - 9 * vy;
          vx += ax * dt; vy += ay * dt;
          x += vx * dt; y += vy * dt;
        }
        wbv += (-160 * wb - 4 * wbv) * dt; wb += wbv * dt;
        rotv += (-260 * rot - 6 * rotv) * dt; rot += rotv * dt;
      }
      if (d.plug) {
        // Ingeplugd: exact vast op het stopcontact.
        x = d.tx; y = d.ty; vx = vy = 0;
      }

      if (d.plug !== ingeplugd) {
        ingeplugd = d.plug;
        zone.classList.toggle('aan', ingeplugd);
      }

      // Hoek: stekker volgt de richting van de kabel, plus een zwiep bij snelheid.
      const basis = d.plug ? 0 : clamp(Math.atan2(x - d.ankerX, Math.max(1, y - d.ankerY)) * 0.5 - vx * 0.0006, -0.45, 0.45);
      const hoek = basis + (d.plug ? clamp(rot, -0.12, 0.12) : rot);
      stekker.style.transform = `translate(${x - HALF}px, ${y}px) rotate(${hoek}rad)`;

      const L = y - d.ankerY;
      if (L > 2) {
        const c1x = d.ankerX + wb;
        const c1y = d.ankerY + L * 0.5;
        const c2x = x - Math.sin(hoek) * L * 0.45 + wb * 0.7;
        const c2y = y - Math.cos(hoek) * L * 0.45;
        const pad = `M ${d.ankerX} ${d.ankerY - 60} L ${d.ankerX} ${d.ankerY} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${x} ${y}`;
        kabel.setAttribute('d', pad);
        puls.setAttribute('d', pad);
        bez = [d.ankerX, d.ankerY, c1x, c1y, c2x, c2y, x, y];
      } else {
        kabel.setAttribute('d', '');
        puls.setAttribute('d', '');
        bez = null;
      }

      // Door blijven lopen zolang de stekker beweegt of vrij (zichtbaar) hangt; ingeplugd volstaat één frame per scroll.
      const beweegt =
        Math.abs(vx) > 0.5 || Math.abs(vy) > 0.5 ||
        Math.abs(wbv) > 2 || Math.abs(wb) > 0.3 || Math.abs(rotv) > 0.05 || Math.abs(rot) > 0.002;
      const vrij = !d.plug && !reduce && d.zichtbaar;
      if (beweegt || vrij) requestAnimationFrame(frame);
      else draait = false;
    }

    function start() {
      if (getComputedStyle(el).display === 'none') return;
      if (!draait) {
        draait = true;
        vorige = performance.now();
        requestAnimationFrame(frame);
      }
    }

    // --- Interactie met de muis ---------------------------------------------------------------
    let mPrev: { x: number; y: number; t: number } | null = null;
    let laatsteVonk = 0;

    function vonk() {
      const nu = performance.now();
      if (nu - laatsteVonk < 450) return;
      laatsteVonk = nu;
      el.classList.remove('vonk');
      void el.getBoundingClientRect(); // animatie herstarten
      el.classList.add('vonk');
    }

    // Kleinste afstand van punt (mx, my) tot de getekende Bézier (16 monsters volstaan voor een hover).
    function afstandTotKabel(mx: number, my: number) {
      if (!bez) return Infinity;
      const [x0, y0, x1, y1, x2, y2, x3, y3] = bez;
      let min = Infinity;
      for (let i = 0; i <= 16; i++) {
        const t = i / 16, u = 1 - t;
        const bx = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3;
        const by = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3;
        min = Math.min(min, Math.hypot(mx - bx, my - by));
      }
      return min;
    }

    function muis(e: PointerEvent) {
      if (e.pointerType !== 'mouse' || reduce || Number.isNaN(x)) return;
      const prev = mPrev;
      mPrev = { x: e.clientX, y: e.clientY, t: e.timeStamp };
      if (!prev) return;
      const dt = Math.max(0.008, (e.timeStamp - prev.t) / 1000);
      const mvx = clamp((e.clientX - prev.x) / dt, -3000, 3000);
      const mvy = clamp((e.clientY - prev.y) / dt, -3000, 3000);

      const zr = zone.getBoundingClientRect();
      const mx = e.clientX - zr.left, my = e.clientY - zr.top;
      const opStekker = Math.hypot(mx - x, my - (y + PLUG_H / 2)) < 42;

      if (opStekker) {
        if (ingeplugd) {
          rotv = clamp(rotv + mvx * 0.004, -5, 5); // rammelen in het stopcontact
        } else {
          vx = clamp(vx + mvx * 0.35, -900, 900);
          vy = clamp(vy + mvy * 0.2, -600, 600);
          rotv = clamp(rotv + mvx * 0.003, -4, 4);
        }
        if (Math.hypot(mvx, mvy) > 150) vonk();
        start();
      } else if (afstandTotKabel(mx, my) < 18) {
        // Tokkel: de kabel buigt mee in de bewegingsrichting en trilt uit; de stekker voelt het een beetje.
        wbv = clamp(wbv + mvx * 0.6, -1400, 1400);
        if (!ingeplugd) vx = clamp(vx + mvx * 0.08, -900, 900);
        else rotv = clamp(rotv + mvx * 0.0012, -3, 3);
        start();
      }
    }

    // Tikken (touch/pen): de stekker zwiept weg met een vonk, of rammelt als hij ingeplugd is.
    function tik(e: PointerEvent) {
      if (e.pointerType === 'mouse' || reduce || Number.isNaN(x)) return;
      const zr = zone.getBoundingClientRect();
      const mx = e.clientX - zr.left, my = e.clientY - zr.top;
      if (Math.hypot(mx - x, my - (y + PLUG_H / 2)) > Math.max(34, PLUG_W)) return;
      const richting = mx < x ? 1 : -1; // weg van de vinger
      if (ingeplugd) rotv = clamp(rotv + richting * 3.5, -5, 5);
      else {
        vx = clamp(vx + richting * 520, -900, 900);
        vy = clamp(vy - 120, -600, 600);
        rotv = clamp(rotv + richting * 2.5, -4, 4);
      }
      vonk();
      start();
    }

    addEventListener('pointermove', muis, { passive: true });
    addEventListener('pointerdown', tik, { passive: true });
    addEventListener('scroll', start, { passive: true });
    addEventListener('resize', () => { maten(); start(); });
    document.fonts?.ready.then(start);
    start();
  });
</script>
