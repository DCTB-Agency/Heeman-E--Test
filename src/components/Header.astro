---
import { Image } from 'astro:assets';
import logo from '../assets/logo-heeman-electrics.png';
import { business, nav, services, serviceUrl, dienstGroepen } from '../data/site';
import DienstIcoon from './DienstIcoon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const core = services.filter((s) => s.priority <= 5);
const extra = services.filter((s) => s.priority > 5);
---

<header class="header-scroll sticky top-0 z-50 border-b border-ink/10 bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
  <div class="container-site flex h-16 items-center gap-6 lg:h-20">
    <a href="/" class="logo-link relative shrink-0" aria-label={`${business.name} — naar de homepage`}>
      <Image src={logo} alt={business.name} width={190} height={60} class="logo-shrink h-9 w-auto lg:h-11" loading="eager" fetchpriority="high" />
      <span class="logo-vonk lg:hidden" aria-hidden="true"></span>
    </a>

    <!-- Desktop -->
    <nav aria-label="Hoofdmenu" class="ml-auto hidden items-center gap-1 lg:flex">
      <div class="relative" data-dropdown>
        <button
          type="button"
          class:list={['flex items-center gap-1 rounded-full px-4 py-2 font-medium hover:bg-ink/5', isActive('/diensten/') && 'text-brand']}
          aria-expanded="false"
          aria-controls="menu-diensten"
          data-dropdown-trigger
        >
          Diensten
          <svg viewBox="0 0 20 20" class="size-4 transition-transform [[aria-expanded=true]>&]:rotate-180" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
        </button>
        <div id="menu-diensten" hidden class="absolute top-full left-0 mt-2 w-[40rem] rounded-2xl border border-ink/10 bg-white p-4 shadow-xl" data-dropdown-panel>
          <div class="grid grid-cols-2 gap-6">
            <ul class="space-y-1">
              {core.map((s) => (
                <li><a href={serviceUrl(s.slug)} class="block rounded-lg px-3 py-2 font-medium hover:bg-paper hover:text-brand">{s.name}</a></li>
              ))}
            </ul>
            <ul class="space-y-1 border-l border-ink/10 pl-6">
              {extra.map((s) => (
                <li><a href={serviceUrl(s.slug)} class="block rounded-lg px-3 py-2 text-muted hover:bg-paper hover:text-brand">{s.name}</a></li>
              ))}
              <li><a href="/diensten/" class="block px-3 py-2 text-sm font-semibold text-brand">Alle diensten →</a></li>
            </ul>
          </div>
        </div>
      </div>

      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['relative flex items-center gap-2 rounded-full px-4 py-2 font-medium hover:bg-ink/5', isActive(item.href) && 'text-brand']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
          {'badge' in item && (
            <span class="job-badge inline-flex items-center rounded-full bg-ink px-2 py-0.5 text-[0.7rem] leading-tight font-semibold text-accent">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </nav>

    <a href={business.phone.href} class="btn btn-primary hidden lg:inline-flex" data-event="click_to_call">
      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
      Bel {business.phone.display}
    </a>

    <!-- Mobiel -->
    <button
      type="button"
      class="ml-auto grid size-11 place-items-center rounded-full hover:bg-ink/5 lg:hidden"
      aria-expanded="false"
      aria-controls="menu-mobiel"
      aria-label="Menu openen"
      data-mobile-trigger
    >
      <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <!-- Mobiel: stroomkabel die zich vult terwijl je door de pagina scrolt -->
  <div class="scroll-kabel lg:hidden" aria-hidden="true"><span></span></div>

  <nav id="menu-mobiel" hidden aria-label="Hoofdmenu" class="menu-mobiel max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-ink/10 bg-paper lg:hidden">
    <div class="container-site py-4">
      <details class="menu-item diensten-menu group/d" style="--n:0">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-2 py-3 font-display text-lg font-semibold">
          Diensten
          <svg viewBox="0 0 20 20" class="size-5 transition-transform group-open/d:rotate-180" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" /></svg>
        </summary>
        <div class="grid gap-5 pt-1 pb-4 sm:grid-cols-3">
          {dienstGroepen.map((g) => (
            <div>
              <p class="px-2 pb-1 text-xs font-semibold tracking-widest text-muted uppercase">{g.titel}</p>
              <ul>
                {g.slugs.map((slug) => (
                  <li>
                    <a href={serviceUrl(slug)} class="flex items-center gap-3 rounded-xl px-2 py-2 font-medium active:bg-ink/5">
                      <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand/10 text-brand"><DienstIcoon slug={slug} class="size-6" /></span>
                      {services.find((s) => s.slug === slug)!.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
      <ul class="border-t border-ink/10 pt-2">
        {nav.map((item, i) => (
          <li class="menu-item" style={`--n:${i + 1}`}>
            <a href={item.href} class="flex items-center gap-2 rounded-lg px-2 py-3 font-display text-lg font-semibold">
              {item.label}
              {'badge' in item && <span class="rounded-full bg-ink px-2 py-0.5 text-xs text-accent">{item.badge}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  @keyframes spark {
    0%, 100% { box-shadow: 0 0 0 0 rgb(255 90 31 / 0.5); }
    50% { box-shadow: 0 0 0 5px rgb(255 90 31 / 0); }
  }
  .job-badge {
    animation: spark 2.4s ease-in-out infinite;
  }

  /* --- Mobiel --- */
  /* Hamburger → kruis */
  .hamburger { position: relative; display: block; width: 22px; height: 16px; }
  .hamburger span {
    position: absolute; left: 0; height: 2px; width: 100%; border-radius: 2px; background: currentColor;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s, width 0.3s;
  }
  .hamburger span:nth-child(1) { top: 0; }
  .hamburger span:nth-child(2) { top: 7px; width: 70%; left: 30%; background: var(--color-brand); }
  .hamburger span:nth-child(3) { top: 14px; }
  [aria-expanded='true'] .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  [aria-expanded='true'] .hamburger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  [aria-expanded='true'] .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Vonk op de stekker van het logo */
  .logo-vonk {
    position: absolute; right: -3px; top: 38%; width: 7px; height: 7px; border-radius: 999px;
    background: var(--color-accent); opacity: 0; pointer-events: none;
  }

  /* Stroomkabel onder de header: vult zich met de scrollvoortgang, met een gloeiend puntje */
  .scroll-kabel { position: absolute; inset: auto 0 -1px 0; height: 3px; overflow: visible; pointer-events: none; }
  .scroll-kabel span {
    position: absolute; inset: 0; background: var(--color-accent); transform-origin: left center; transform: scaleX(0);
  }
  .scroll-kabel span::after {
    content: ''; position: absolute; right: -4px; top: 50%; width: 9px; height: 9px; margin-top: -4.5px; border-radius: 999px;
    background: #ffd2bd; box-shadow: 0 0 8px 2px var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-vonk { animation: logo-vonk 4.5s ease-out 1.5s infinite; }
    @supports (animation-timeline: scroll()) {
      .scroll-kabel span { animation: kabel-vul linear both; animation-timeline: scroll(root); }
    }
    .menu-mobiel:not([hidden]) .menu-item { animation: menu-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--n) * 55ms); }
  }
  @keyframes logo-vonk {
    0%, 70%, 100% { opacity: 0; transform: scale(0.4); box-shadow: 0 0 0 0 rgb(255 90 31 / 0); }
    74% { opacity: 1; transform: scale(1.2); box-shadow: 0 0 10px 3px rgb(255 90 31 / 0.8); }
    78% { opacity: 0.3; }
    82% { opacity: 1; transform: scale(1); }
    90% { opacity: 0; transform: scale(0.6); }
  }
  @keyframes kabel-vul { to { transform: scaleX(1); } }
  @keyframes menu-in { from { opacity: 0; translate: 0 -8px; } to { opacity: 1; translate: none; } }
</style>

<script>
  // Diensten-dropdown (desktop): klik/Enter opent, Escape of klik buiten sluit.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
    const panel = wrap.querySelector<HTMLElement>('[data-dropdown-panel]')!;
    const set = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    trigger.addEventListener('click', () => set(Boolean(panel.hidden)));
    wrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { set(false); trigger.focus(); }
    });
    wrap.addEventListener('focusout', (e) => {
      if (!wrap.contains(e.relatedTarget as Node)) set(false);
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) set(false);
    });
  });

  // Mobiel menu
  const mTrigger = document.querySelector<HTMLButtonElement>('[data-mobile-trigger]');
  const mPanel = document.getElementById('menu-mobiel');
  mTrigger?.addEventListener('click', () => {
    if (!mPanel) return;
    const open = mPanel.hidden;
    mPanel.hidden = !open;
    mTrigger.setAttribute('aria-expanded', String(open));
    mTrigger.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
  });
</script>
