---
import { business, job } from '../data/site';

interface Props {
  variant: 'default' | 'jobs';
}
const { variant } = Astro.props;

const icons = {
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
  whatsapp: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.1.1.6-.1 1.2z',
  quote: 'M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm6 1.5V9h4.5M9 13h6M9 17h6',
  apply: 'M12 4v16M4 12h16',
};

const items =
  variant === 'jobs'
    ? [
        { label: 'Solliciteer', href: `${job.url}#solliciteer`, icon: icons.apply, primary: true, event: 'job_apply_click', stroke: true },
        { label: 'WhatsApp', href: business.whatsapp.jobHref, icon: icons.whatsapp, event: 'job_whatsapp_click' },
        { label: 'Bel', href: business.phone.href, icon: icons.phone, event: 'job_call_click' },
      ]
    : [
        { label: 'Bel', href: business.phone.href, icon: icons.phone, primary: true, event: 'click_to_call' },
        { label: 'WhatsApp', href: business.whatsapp.href, icon: icons.whatsapp, event: 'whatsapp_click' },
        { label: 'Offerte', href: '/offerte/', icon: icons.quote, event: 'offerte_click', stroke: true },
      ];
---

<nav
  aria-label="Snel contact"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-ink pb-[env(safe-area-inset-bottom)] lg:hidden"
>
  <ul class="grid grid-cols-3">
    {items.map((it) => (
      <li>
        <a
          href={it.href}
          data-event={it.event}
          {...(it.href.startsWith('https://') ? { target: '_blank', rel: 'noopener' } : {})}
          class:list={[
            'flex h-[4.5rem] flex-col items-center justify-center gap-1 text-sm font-semibold',
            it.primary ? 'bg-accent text-ink' : 'text-white active:bg-white/10',
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"
            fill={it.stroke ? 'none' : 'currentColor'}
            stroke={it.stroke ? 'currentColor' : 'none'}
            stroke-width={it.stroke ? 2 : undefined}
            stroke-linecap="round" stroke-linejoin="round"
          ><path d={it.icon} /></svg>
          {it.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
