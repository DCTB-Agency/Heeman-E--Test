---
// /kennisbank/ — gidsen en uitleg (CLAUDE.md § 5, § 11.4). Geplande artikels worden getoond maar niet gelinkt.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import { artikels, gepland, artikelUrl } from '../../data/kennisbank';
import { breadcrumbSchema } from '../../lib/schema';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Kennisbank', url: '/kennisbank/' },
];
const datum = (d: string) => new Date(d).toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Kennisbank elektriciteit · Heeman Electrics Schilde"
  description="Heldere uitleg over laadpalen, de elektrische keuring, Niko Home Control en renovatie. Geschreven door Bert, elektricien in Schilde."
  schema={[breadcrumbSchema(kruimels)]}
>
  <section class="container-site py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="fade-up text-muted" />
    <h1 class="mt-6 text-display"><span class="line-mask"><span style="--i:1">Kennisbank</span></span></h1>
    <p class="fade-up mt-6 max-w-2xl text-lg text-muted" style="--d:250ms">Eerlijke uitleg over elektriciteit, zonder vakjargon. Geschreven door Bert Heeman, erkend elektricien in Schilde.</p>

    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {artikels.map((a) => (
        <li class="reveal">
          <a href={artikelUrl(a.slug)} class="group flex h-full flex-col rounded-3xl bg-ink p-8 text-white">
            <p class="text-sm text-on-ink-muted"><time datetime={a.bijgewerkt}>{datum(a.bijgewerkt)}</time></p>
            <h2 class="mt-3 font-display text-3xl font-semibold group-hover:text-accent">{a.titel}</h2>
            <p class="mt-3 flex-1 text-on-ink-muted">{a.beschrijving}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-display font-semibold text-accent">Lees <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="reveal mt-20 font-display text-2xl font-semibold">Binnenkort</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {gepland.map((t) => <li class="reveal rounded-2xl border border-dashed border-ink/20 p-5 text-muted">{t}</li>)}
    </ul>
  </section>
</Base>
