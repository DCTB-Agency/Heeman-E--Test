---
// /jobs/junior-elektricien/ — CLAUDE.md § 6.3–6.4. Tekst en JobPosting-schema komen uit data/vacature.ts.
import Base from '../../../layouts/Base.astro';
import Kruimels from '../../../components/Kruimels.astro';
import InHetKort from '../../../components/InHetKort.astro';
import DagTijdlijn from '../../../components/DagTijdlijn.astro';
import Faq from '../../../components/Faq.astro';
import Foto from '../../../components/Foto.astro';
import Sollicitatieformulier from '../../../components/Sollicitatieformulier.astro';
import { SITE_URL, business, job } from '../../../data/site';
import { vacature, vacatureHtml } from '../../../data/vacature';
import { breadcrumbSchema, faqSchema } from '../../../lib/schema';
import { metTodo } from '../../../lib/tekst';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Jobs', url: '/jobs/' },
  { naam: 'Junior elektricien', url: job.url },
];

const jobPosting = {
  '@type': 'JobPosting',
  title: vacature.titel,
  description: vacatureHtml(),
  datePosted: vacature.datePosted,
  validThrough: vacature.validThrough,
  employmentType: 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: business.name,
    sameAs: SITE_URL,
    logo: `${SITE_URL}/logo.png`,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      addressLocality: business.address.locality,
      postalCode: business.address.postalCode,
      addressRegion: business.address.region,
      addressCountry: business.address.country,
    },
  },
  educationRequirements: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'high school' },
  experienceRequirements: 'no requirements',
  directApply: true,
  industry: 'Elektrotechnische installatiewerken',
  occupationalCategory: '47-2111.00 Electricians',
  inLanguage: 'nl-BE',
};

const blokken = [
  { titel: 'Wat ga je doen?', items: vacature.taken },
  { titel: 'Wie zoek ik?', items: vacature.profiel },
  { titel: 'Wat bied ik?', items: vacature.aanbod },
];
---

<Base
  title={vacature.metaTitle}
  description={vacature.metaDescription}
  ogImage="/og/bert.jpg"
  schema={[jobPosting, faqSchema(vacature.faq), breadcrumbSchema(kruimels)]}
>
  <!-- HERO -->
  <section class="bg-accent text-ink">
    <div class="container-site grid gap-12 py-12 sm:py-16 lg:grid-cols-[1.35fr_1fr] lg:gap-16 lg:py-20">
      <div>
        <Kruimels kruimels={kruimels} class="fade-up" />
        <h1 class="mt-6 text-[clamp(2.1rem,1.4rem+2.6vw,3.5rem)] leading-[1.02] tracking-tight">
          <span class="line-mask"><span style="--i:1">Junior elektricien (m/v/x)</span></span>
          <span class="line-mask"><span style="--i:2">in Schilde — leer het vak</span></span>
          <span class="line-mask"><span style="--i:3">naast Bert</span></span>
        </h1>
        <p class="fade-up mt-6 max-w-2xl text-lg" style="--d:450ms">{vacature.intro}</p>
        <div class="fade-up mt-8 flex flex-wrap gap-3" style="--d:600ms">
          <a href="#solliciteer" class="btn bg-ink text-white hover:bg-ink-soft" data-event="job_apply_click">Solliciteer in 1 minuut</a>
          <a href={business.whatsapp.jobHref} class="btn btn-ghost" target="_blank" rel="noopener" data-event="job_whatsapp_click">WhatsApp</a>
          <a href={business.phone.href} class="btn btn-ghost" data-event="job_call_click">Bel {business.phone.display}</a>
        </div>
      </div>
      <div class="fade-up self-start [&_h2_svg]:text-ink" style="--d:300ms"><InHetKort items={vacature.inHetKort} /></div>
    </div>
  </section>

  <!-- TAKEN / PROFIEL / AANBOD -->
  <section class="section">
    <div class="container-site grid gap-6 lg:grid-cols-3">
      {blokken.map((b, i) => (
        <div class="reveal rounded-3xl border border-ink/10 bg-white p-7 sm:p-8" style={`--i:${i}`}>
          <h2 class="font-display text-2xl font-semibold">{b.titel}</h2>
          <ul class="mt-6 space-y-4">
            {b.items.map((it) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-brand" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                <span set:html={metTodo(it)} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- EEN DAG MET BERT -->
  <section class="section on-ink bg-ink text-white" style="--dag-bg: var(--color-ink)">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">Zo ziet je dag eruit</p>
          <h2 class="h2 mt-3">Een dag met Bert</h2>
        </div>
        <Foto id="stopcontactenPlaatsing" class="reveal aspect-[4/3]" sizes="(min-width: 1024px) 20rem, 100vw" />
      </div>
      <DagTijdlijn class="mt-14 text-accent [&_p]:text-white" />
    </div>
  </section>

  <!-- ZO VERLOOPT HET -->
  <section class="section">
    <div class="container-site">
      <p class="eyebrow reveal">Solliciteren</p>
      <h2 class="h2 reveal mt-3">Zo verloopt het</h2>
      <ol class="reveal-stagger mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {vacature.stappen.map((s, i) => (
          <li class="stap relative rounded-3xl border border-ink/10 bg-white p-7" style={`--i:${i}`}>
            <span class="font-display text-5xl font-semibold text-accent">{i + 1}</span>
            <h3 class="mt-4 font-display text-xl font-semibold">{s.titel}</h3>
            <p class="mt-2 text-muted" set:html={metTodo(s.tekst)} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FORMULIER -->
  <section id="solliciteer" class="section scroll-mt-20 bg-sand/50" aria-labelledby="formulier-titel">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">In 1 minuut</p>
        <h2 id="formulier-titel" class="h2 mt-3">Solliciteer</h2>
        <p class="mt-5 text-lg text-muted">Naam en gsm is genoeg om te starten. Een cv hoeft niet.</p>
        <div class="mt-8 space-y-3">
          <p class="font-semibold">Liever anders?</p>
          <a href={business.whatsapp.jobHref} class="flex items-center gap-3 font-medium hover:text-brand" target="_blank" rel="noopener" data-event="job_whatsapp_click">
            <span class="grid size-10 place-items-center rounded-full bg-ink text-accent" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z" /></svg>
            </span>
            Stuur een WhatsApp
          </a>
          <a href={business.phone.href} class="flex items-center gap-3 font-medium hover:text-brand" data-event="job_call_click">
            <span class="grid size-10 place-items-center rounded-full bg-ink text-accent" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
            </span>
            Bel {business.phone.display}
          </a>
          <a href={job.mailto} class="flex items-center gap-3 font-medium hover:text-brand">
            <span class="grid size-10 place-items-center rounded-full bg-ink text-accent" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            </span>
            Mail je cv naar {business.email}
          </a>
        </div>
      </div>
      <div class="reveal rounded-3xl bg-white p-6 shadow-[0_24px_60px_-40px_rgb(28_13_10/0.5)] sm:p-10">
        <Sollicitatieformulier />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="job-faq">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Vragen</p>
        <h2 id="job-faq" class="h2 mt-3">Goed om te weten</h2>
      </div>
      <Faq vragen={vacature.faq} class="reveal" />
    </div>
  </section>
</Base>
