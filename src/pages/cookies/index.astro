---
// /cookies/ — overzicht van wat de site bewaart (CLAUDE.md § 13). Feitelijk; juridisch nazicht door DCTB.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import { business, analytics } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Cookies', url: '/cookies/' },
];
const rijen = [
  { naam: 'he-toestemming', soort: 'Lokale opslag (browser)', doel: 'Onthoudt of u statistieken aanvaardt of weigert', duur: `${analytics.toestemmingGeldigDagen} dagen`, wanneer: 'Altijd (noodzakelijk)' },
  { naam: 'he-job-bar', soort: 'Lokale opslag (browser)', doel: 'Onthoudt dat u de melding over de vacature sloot', duur: 'Tot u uw browsergegevens wist', wanneer: 'Als u de melding sluit' },
  { naam: '_ga', soort: 'Cookie van Google Analytics', doel: 'Onderscheidt bezoekers voor anonieme statistieken', duur: '2 jaar', wanneer: 'Alleen na “Aanvaarden”' },
  { naam: '_ga_…', soort: 'Cookie van Google Analytics', doel: 'Bewaart de sessie voor statistieken', duur: '2 jaar', wanneer: 'Alleen na “Aanvaarden”' },
];
---

<Base title="Cookies · Heeman Electrics" description="Welke cookies en gegevens heeman-electrics.be bewaart, waarom, en hoe u uw keuze wijzigt." schema={[breadcrumbSchema(kruimels)]}>
  <section class="container-site max-w-4xl py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="text-muted" />
    <h1 class="mt-6 text-display">Cookies</h1>
    <p class="mt-6 text-lg text-muted">
      Deze website gebruikt zo weinig mogelijk cookies. Google Analytics wordt pas geladen als u daar toestemming voor geeft.
      Ik gebruik het niet voor advertenties.
    </p>
    <button type="button" class="btn btn-primary mt-8" data-cookie-instellingen>Mijn keuze wijzigen</button>

    <div class="mt-12 overflow-x-auto rounded-2xl border border-ink/10 bg-white">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead class="bg-sand/50 font-semibold">
          <tr><th class="p-4">Naam</th><th class="p-4">Soort</th><th class="p-4">Doel</th><th class="p-4">Bewaartermijn</th><th class="p-4">Wanneer</th></tr>
        </thead>
        <tbody class="divide-y divide-ink/10">
          {rijen.map((r) => (
            <tr><td class="p-4 font-mono">{r.naam}</td><td class="p-4">{r.soort}</td><td class="p-4">{r.doel}</td><td class="p-4">{r.duur}</td><td class="p-4">{r.wanneer}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold">Google Analytics</h2>
    <p class="mt-3 text-muted">
      Na uw toestemming verzamelt Google Analytics (Google Ireland Ltd.) statistieken over het gebruik van deze site, zoals bezochte pagina's
      en klikken op de bel- en WhatsApp-knoppen. Advertentiefuncties staan uit (Consent Mode: advertentieopslag en -personalisatie geweigerd).
      Trekt u uw toestemming in, dan worden de Google Analytics-cookies van deze site verwijderd.
    </p>

    <h2 class="mt-10 font-display text-2xl font-semibold">Vragen?</h2>
    <p class="mt-3 text-muted">Mail naar <a href={`mailto:${business.email}`} class="font-semibold text-brand underline underline-offset-4">{business.email}</a>. Meer over hoe ik met uw gegevens omga, leest u in de <a href="/privacy/" class="font-semibold text-brand underline underline-offset-4">privacyverklaring</a>.</p>
    <p class="mt-10 text-sm"><mark class="todo">[TE BEVESTIGEN: juridisch nazicht cookiebeleid door DCTB]</mark></p>
  </section>
</Base>
