---
// Eén realisatie (CLAUDE.md § 8): titel met gemeente, voor/na, situatie → oplossing → resultaat.
// Schema: CreativeWork. Zolang er placeholders in staan: noindex (data/noindex.ts).
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import Foto from '../../components/Foto.astro';
import VoorNa from '../../components/VoorNa.astro';
import { SITE_URL, business, services, serviceUrl } from '../../data/site';
import { realisaties, realisatieUrl, type Realisatie } from '../../data/realisaties';
import { noindexUrls } from '../../data/noindex';
import { breadcrumbSchema } from '../../lib/schema';
import { metTodo, heeftTodo } from '../../lib/tekst';

export function getStaticPaths() {
  return realisaties.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Realisatie };
const url = realisatieUrl(r.slug);
const dienst = services.find((s) => s.slug === r.dienst)!;
const gemeenteBekend = !heeftTodo(r.gemeente);
const titelVolledig = gemeenteBekend ? `${r.titel} in ${r.gemeente}` : r.titel;
const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Realisaties', url: '/realisaties/' },
  { naam: r.titel, url },
];
const schema = {
  '@type': 'CreativeWork',
  '@id': `${SITE_URL}${url}#realisatie`,
  name: titelVolledig,
  url: `${SITE_URL}${url}`,
  image: `${SITE_URL}/og/${r.fotos.hoofd}.jpg`,
  creator: { '@id': `${SITE_URL}/#organization` },
  about: { '@type': 'Service', name: dienst.name, url: `${SITE_URL}${serviceUrl(dienst.slug)}` },
  ...(gemeenteBekend ? { locationCreated: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: r.gemeente, addressCountry: 'BE' } } } : {}),
};
const blokken = [
  { titel: 'Situatie', tekst: r.situatie },
  { titel: 'Oplossing', tekst: r.oplossing },
  { titel: 'Resultaat', tekst: r.resultaat },
];
const anderen = realisaties.filter((x) => x.slug !== r.slug).slice(0, 3);
---

<Base
  title={`${titelVolledig} · Realisatie Heeman Electrics`.slice(0, 60)}
  description={`${titelVolledig}: ${dienst.name.toLowerCase()} door Heeman Electrics, erkend elektricien in Schilde en omgeving.`}
  ogImage={`/og/${r.fotos.hoofd}.jpg`}
  noindex={noindexUrls.has(url)}
  schema={[schema, breadcrumbSchema(kruimels)]}
>
  <article class="container-site py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="fade-up text-muted" />
    <div class="mt-6 flex flex-wrap gap-2">
      <a href={serviceUrl(dienst.slug)} class="rounded-full bg-ink px-3 py-1 text-sm font-semibold text-accent">{dienst.name}</a>
      <span class="rounded-full border border-ink/15 bg-white px-3 py-1 text-sm" set:html={metTodo(r.gemeente)} />
    </div>
    <h1 class="fade-up mt-4 max-w-4xl text-[clamp(2.25rem,1.5rem+3vw,4rem)] leading-[1.03] tracking-tight">
      {r.titel}{gemeenteBekend && <> in <span class="text-brand">{r.gemeente}</span></>}
    </h1>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      {r.fotos.voor
        ? <VoorNa voor={r.fotos.voor} na={r.fotos.hoofd} class="fade-up aspect-[4/5] sm:aspect-[4/3]" />
        : <Foto id={r.fotos.hoofd} class="fade-up aspect-[4/5] sm:aspect-[4/3]" eager sizes="(min-width: 1024px) 60vw, 100vw" />}

      <div class="space-y-6">
        {blokken.map((b, i) => (
          <section class="reveal rounded-3xl border border-ink/10 bg-white p-6" style={`--i:${i}`}>
            <p class="font-mono text-sm font-semibold text-brand">0{i + 1}</p>
            <h2 class="mt-1 font-display text-2xl font-semibold">{b.titel}</h2>
            <p class="mt-2 text-muted" set:html={metTodo(b.tekst)} />
          </section>
        ))}
        <div class="reveal rounded-3xl bg-ink p-6 text-white">
          <p class="font-display text-xl font-semibold">Ook zoiets nodig?</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={`/offerte/?dienst=${dienst.slug}`} class="btn btn-accent">Gratis offerte</a>
            <a href={business.phone.href} class="btn btn-ghost" data-event="click_to_call">Bel {business.phone.display}</a>
          </div>
        </div>
      </div>
    </div>

    <h2 class="h2 reveal mt-24">Meer realisaties</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {anderen.map((x) => (
        <li class="reveal">
          <a href={realisatieUrl(x.slug)} class="group block">
            <Foto id={x.fotos.hoofd} class="aspect-[4/3]" sizes="(min-width: 768px) 30vw, 100vw" />
            <p class="mt-3 font-display text-lg font-semibold group-hover:text-brand">{x.titel}</p>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>
