---
// Groot jobs-blok op de homepage (CLAUDE.md § 6.1 + § 7.7): accentkleur, portret, "een dag op de baan".
import DagTijdlijn from './DagTijdlijn.astro';
import Foto from './Foto.astro';
import { job } from '../data/site';
import { vacatures, vacatureUrl } from '../data/vacature';
---

<section class="section relative overflow-clip bg-accent text-ink" aria-labelledby="jobs-blok">
  <div class="container-site">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div class="reveal">
        <p class="font-display text-sm font-semibold tracking-widest uppercase">{job.badge}</p>
        <h2 id="jobs-blok" class="h2 mt-3">Klaar voor een nieuwe uitdaging?</h2>
        <p class="mt-5 max-w-2xl text-lg">
          Wij zijn op zoek naar jou! Om de groei van ons bedrijf te verzekeren, zoeken we een <strong>ervaren elektricien</strong>
          (minstens 3 jaar ervaring) en een <strong>junior elektricien</strong> die het vak wil leren. Ook voor een stageplaats kan je
          bij ons terecht. Al onze werven liggen in de buurt.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {vacatures.map((v, i) => (
            <a href={vacatureUrl(v.slug)} class:list={['btn', i === 0 ? 'bg-ink text-white hover:bg-ink-soft' : 'btn-ghost']}>{v.titel}</a>
          ))}
        </div>
      </div>
      <Foto id="bert" class="reveal aspect-[4/5] shadow-[0_30px_60px_-30px_rgb(28_13_10/0.6)]" sizes="(min-width: 1024px) 22rem, 100vw" />
    </div>

    <div class="mt-16 border-t-2 border-ink/15 pt-10" style="--dag-bg: var(--color-accent)">
      <h3 class="font-display text-2xl font-semibold">Een dag op de baan</h3>
      <DagTijdlijn class="mt-8" />
    </div>
  </div>
</section>
