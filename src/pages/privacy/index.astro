---
// /privacy/ — privacyverklaring (CLAUDE.md § 13). Feitelijk opgesteld op basis van hoe de site werkt;
// juridisch nazicht door DCTB vóór livegang. Onbekend = [AANVULLEN] / [TE BEVESTIGEN].
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import { business, analytics } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
import { metTodo } from '../../lib/tekst';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Privacyverklaring', url: '/privacy/' },
];
const bijgewerkt = '23 september 2026';

const verwerkingen = [
  {
    titel: 'Offerte- en contactformulier',
    gegevens: 'Naam, gsm, e-mail (optioneel), gemeente, gevraagde dienst, uw omschrijving, contactvoorkeur en eventuele foto’s die u zelf meestuurt.',
    hoe: 'Het formulier wordt niet op de website bewaard: het opent uw eigen mailprogramma met een bericht aan mij. De gegevens komen pas bij mij toe als u die mail verstuurt.',
    doel: 'Uw vraag beantwoorden, een bezoek plannen en een offerte opmaken.',
    grond: 'Maatregelen op uw verzoek vóór een overeenkomst (art. 6.1.b AVG).',
    termijn: '[AANVULLEN: bv. 2 jaar na het laatste contact als er geen opdracht volgt; bij een opdracht zolang de boekhoudwetgeving dat vereist]',
  },
  {
    titel: 'Sollicitaties',
    gegevens: 'Naam, gsm, e-mail (optioneel), woonplaats, diploma, rijbewijs B, motivatie en uw cv (optioneel).',
    hoe: 'Het sollicitatieformulier wordt verwerkt door Netlify (hosting van deze site) en naar mij doorgestuurd. Uw cv is niet publiek bereikbaar.',
    doel: 'Uw sollicitatie beoordelen en contact met u opnemen.',
    grond: 'Maatregelen op uw verzoek vóór een (arbeids)overeenkomst (art. 6.1.b AVG).',
    termijn: '[AANVULLEN: bv. 6 maanden na afloop van de selectieprocedure, tenzij u toestemming geeft om ze langer te bewaren]',
  },
  {
    titel: 'Bellen, WhatsApp en e-mail',
    gegevens: 'Uw telefoonnummer of e-mailadres en wat u mij zelf laat weten.',
    hoe: 'WhatsApp is een dienst van WhatsApp Ireland Ltd.; hun eigen privacybeleid is van toepassing.',
    doel: 'Uw vraag beantwoorden.',
    grond: 'Maatregelen op uw verzoek vóór een overeenkomst en mijn gerechtvaardigd belang om te antwoorden (art. 6.1.b en f AVG).',
    termijn: '[AANVULLEN]',
  },
  {
    titel: 'Websitestatistieken (Google Analytics)',
    gegevens: 'Gebruiksgegevens zoals bezochte pagina’s, klikken op knoppen, apparaat- en browsertype en een afgeleide, niet-precieze locatie.',
    hoe: `Alleen als u daar via de cookiebanner toestemming voor geeft. Advertentiefuncties staan uit. U kan uw keuze altijd wijzigen.`,
    doel: 'Begrijpen welke pagina’s nuttig zijn en de website verbeteren.',
    grond: 'Uw toestemming (art. 6.1.a AVG).',
    termijn: '[TE BEVESTIGEN: bewaartermijn in GA4, bv. 14 maanden]',
  },
];

const verwerkers = [
  { naam: 'Netlify, Inc.', rol: 'Hosting van de website en verwerking van het sollicitatieformulier', waar: 'Verenigde Staten — doorgifte op basis van het EU-VS-gegevensprivacykader of standaardcontractbepalingen [te controleren]' },
  { naam: 'Google Ireland Ltd.', rol: 'Google Analytics, alleen na toestemming', waar: 'EU; mogelijke doorgifte naar de VS op basis van het EU-VS-gegevensprivacykader [te controleren]' },
  { naam: '[AANVULLEN: e-mailprovider van info@heeman-electrics.be]', rol: 'Ontvangen en bewaren van e-mail', waar: '[AANVULLEN]' },
  { naam: '[AANVULLEN: boekhouder / boekhoudsoftware]', rol: 'Facturatie en boekhouding bij een opdracht', waar: '[AANVULLEN]' },
];

const rechten = [
  ['Inzage', 'welke gegevens ik van u heb'],
  ['Verbetering', 'van onjuiste of onvolledige gegevens'],
  ['Wissing', 'als er geen reden meer is om ze te bewaren'],
  ['Beperking', 'van de verwerking in bepaalde gevallen'],
  ['Overdraagbaarheid', 'uw gegevens in een gangbaar formaat ontvangen'],
  ['Bezwaar', 'tegen een verwerking op basis van gerechtvaardigd belang'],
  ['Intrekken van toestemming', 'bv. voor statistieken, op elk moment'],
];
---

<Base
  title="Privacyverklaring · Heeman Electrics"
  description="Hoe Heeman Electrics in Schilde omgaat met uw gegevens bij offertes, contact, sollicitaties en websitestatistieken, en welke rechten u heeft."
  schema={[breadcrumbSchema(kruimels)]}
>
  <article class="container-site max-w-4xl py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="text-muted" />
    <h1 class="mt-6 text-display">Privacyverklaring</h1>
    <p class="mt-4 text-sm text-muted">Laatst bijgewerkt op {bijgewerkt}</p>
    <p class="mt-6 text-lg">
      Ik ga zorgvuldig om met uw gegevens en verzamel niet meer dan nodig. Hieronder leest u welke gegevens ik verwerk,
      waarom, hoe lang, en welke rechten u heeft. Dit volgt de Algemene Verordening Gegevensbescherming (AVG/GDPR).
    </p>

    <h2 class="mt-12 font-display text-2xl font-semibold">Wie is verantwoordelijk?</h2>
    <address class="mt-4 rounded-2xl border border-ink/10 bg-white p-6 not-italic">
      <strong>{business.name}</strong> — <span set:html={metTodo(business.legalName)} /><br />
      {business.address.street}, {business.address.postalCode} {business.address.locality}<br />
      Ondernemingsnummer {business.vat}<br />
      <a href={`mailto:${business.email}`} class="font-semibold text-brand underline underline-offset-4">{business.email}</a> ·
      <a href={business.phone.href} class="font-semibold text-brand underline underline-offset-4">{business.phone.display}</a>
    </address>

    <h2 class="mt-12 font-display text-2xl font-semibold">Welke gegevens, waarom en hoe lang?</h2>
    <div class="mt-6 space-y-6">
      {verwerkingen.map((v) => (
        <section class="rounded-2xl border border-ink/10 bg-white p-6">
          <h3 class="font-display text-xl font-semibold">{v.titel}</h3>
          <dl class="mt-4 grid gap-3 text-[0.95rem] sm:grid-cols-[10rem_1fr]">
            <dt class="font-semibold">Gegevens</dt><dd>{v.gegevens}</dd>
            <dt class="font-semibold">Hoe</dt><dd>{v.hoe}</dd>
            <dt class="font-semibold">Doel</dt><dd>{v.doel}</dd>
            <dt class="font-semibold">Rechtsgrond</dt><dd>{v.grond}</dd>
            <dt class="font-semibold">Bewaartermijn</dt><dd set:html={metTodo(v.termijn)} />
          </dl>
        </section>
      ))}
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold">Wie krijgt uw gegevens?</h2>
    <p class="mt-3">Ik verkoop uw gegevens nooit. Ik werk met deze dienstverleners (verwerkers), die uw gegevens alleen in mijn opdracht gebruiken:</p>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-ink/10 bg-white">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead class="bg-sand/50 font-semibold"><tr><th class="p-4">Dienstverlener</th><th class="p-4">Rol</th><th class="p-4">Waar</th></tr></thead>
        <tbody class="divide-y divide-ink/10">
          {verwerkers.map((w) => (
            <tr><td class="p-4" set:html={metTodo(w.naam)} /><td class="p-4">{w.rol}</td><td class="p-4" set:html={metTodo(w.waar)} /></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold">Cookies</h2>
    <p class="mt-3">
      Google Analytics wordt alleen geladen na uw toestemming; uw keuze wordt {analytics.toestemmingGeldigDagen} dagen onthouden.
      Alle details staan op de pagina <a href="/cookies/" class="font-semibold text-brand underline underline-offset-4">Cookies</a>.
    </p>
    <button type="button" class="btn btn-ghost mt-4" data-cookie-instellingen>Cookie-instellingen wijzigen</button>

    <h2 class="mt-12 font-display text-2xl font-semibold">Uw rechten</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {rechten.map(([r, uitleg]) => (
        <li class="rounded-2xl border border-ink/10 bg-white p-4"><strong>{r}</strong>: {uitleg}</li>
      ))}
    </ul>
    <p class="mt-4">
      Stuur uw vraag naar <a href={`mailto:${business.email}`} class="font-semibold text-brand underline underline-offset-4">{business.email}</a>.
      Ik antwoord binnen één maand. Om misbruik te voorkomen, kan ik vragen om uw identiteit te bevestigen.
    </p>

    <h2 class="mt-12 font-display text-2xl font-semibold">Klacht?</h2>
    <p class="mt-3">
      Neem gerust eerst contact met mij op. U kan ook een klacht indienen bij de Gegevensbeschermingsautoriteit (GBA),
      Drukpersstraat 35, 1000 Brussel —
      <a href="https://www.gegevensbeschermingsautoriteit.be" class="font-semibold text-brand underline underline-offset-4" target="_blank" rel="noopener">gegevensbeschermingsautoriteit.be ↗</a>.
    </p>

    <h2 class="mt-12 font-display text-2xl font-semibold">Beveiliging en wijzigingen</h2>
    <p class="mt-3">
      De website gebruikt een beveiligde verbinding (HTTPS). Ik neem redelijke maatregelen om uw gegevens te beschermen.
      Deze verklaring kan wijzigen; de datum bovenaan toont de laatste versie.
    </p>

    <p class="mt-12 text-sm"><mark class="todo">[TE BEVESTIGEN: juridisch nazicht van deze privacyverklaring door DCTB]</mark></p>
  </article>
</Base>
