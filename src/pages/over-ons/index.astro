---
// /over-ons/ — "Wie we zijn". Het bedrijf centraal; dit is de énige pagina waar Bert vermeld wordt,
// als oprichter, niet in de titel (03-10-2026). Person-schema voor E-E-A-T.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import Foto from '../../components/Foto.astro';
import FotoPlaceholder from '../../components/FotoPlaceholder.astro';
import { SITE_URL, business, job } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Wie we zijn', url: '/over-ons/' },
];
const bertId = `${SITE_URL}/over-ons/#bert`;
const paginaSchema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE_URL}/over-ons/#page`,
    url: `${SITE_URL}/over-ons/`,
    name: `Wie we zijn – ${business.name}`,
    about: { '@id': `${SITE_URL}/#organization` },
    mentions: { '@id': bertId },
  },
  {
    '@type': 'Person',
    '@id': bertId,
    name: business.owner,
    jobTitle: business.ownerTitle,
    worksFor: { '@id': `${SITE_URL}/#organization` },
    workLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: business.address.locality, addressCountry: 'BE' } },
    knowsAbout: ['elektrische installaties', 'laadpalen', 'Niko Home Control', 'AREI', 'renovatie elektriciteit', 'zonnepanelen', 'thuisbatterij'],
  },
];

const klanten = [
  { titel: 'Particulieren', tekst: 'Algemene elektriciteitswerken, renovatie, nieuwbouw en Niko Home Control, in woningen en villa’s.' },
  { titel: 'Bedrijven', tekst: 'Laadpunten voor eigen wagens, personeel en bezoekers, en elektrische installaties in kantoren en handelspanden.' },
  { titel: 'Syndici', tekst: 'Gemeenschappelijke laadinfrastructuur en elektriciteit in appartementsgebouwen, in overleg met de syndicus.' },
  { titel: 'Aannemers en architecten', tekst: 'Volledige installaties voor nieuwbouw en renovatie, afgestemd op de planning van de werf, met schema’s voor de keuring.' },
];

const werkwijze = [
  { titel: 'Verkennend gesprek', tekst: 'We komen eerst langs en bekijken samen met u wat u nodig heeft.' },
  { titel: 'Meedenken', tekst: 'Geen snelle oplossing, maar een voorstel dat ook op lange termijn positief uitdraait voor u.' },
  { titel: 'Eén vast aanspreekpunt', tekst: 'Een duidelijke offerte, en van de opstart tot de oplevering weet u bij wie u terechtkunt.' },
  { titel: 'Kwaliteitscontrole', tekst: 'Elke installatie wordt gecontroleerd: netjes afgewerkt, volgens het AREI, met de nodige schema’s.' },
];
---

<Base
  title="Wie we zijn · Heeman Electrics, elektricien in Schilde"
  description="Heeman Electrics is een erkende elektricien uit Schilde, sinds 2018. 10+ jaar vakkennis, voor particulieren, bedrijven, syndici en aannemers."
  ogImage="/og/verdeelkast.jpg"
  schema={[...paginaSchema, breadcrumbSchema(kruimels)]}
>
  <section class="container-site grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[1.3fr_1fr] lg:gap-16 lg:py-20">
    <div>
      <Kruimels kruimels={kruimels} class="fade-up text-muted" />
      <h1 class="mt-6 text-display">
        <span class="line-mask"><span style="--i:1">Heeman Electrics,</span></span>
        <span class="line-mask"><span style="--i:2">elektricien in <span class="text-brand">uw regio</span></span></span>
      </h1>
      <p class="fade-up mt-6 max-w-2xl text-xl leading-relaxed" style="--d:350ms">
        {business.name} ({business.legalName}) is een erkende elektricien uit Schilde, sinds 2018. Met {business.experience} werken we
        voor particulieren, bedrijven, syndici en aannemers in Schilde en de oostrand van Antwerpen.
      </p>
      <div class="fade-up mt-8 flex flex-wrap gap-3" style="--d:450ms">
        <a href={business.phone.href} class="btn btn-primary" data-event="click_to_call">Bel {business.phone.display}</a>
        <a href="/offerte/" class="btn btn-ghost">Vrijblijvende offerte</a>
      </div>
    </div>
    <Foto id="verdeelkast" class="fade-up aspect-[4/5] shadow-[0_30px_60px_-30px_rgb(28_13_10/0.5)]" eager sizes="(min-width: 1024px) 40vw, 100vw" />
  </section>

  <section class="section border-t border-ink/10 bg-white/60" aria-labelledby="klanten">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <h2 id="klanten" class="h2">Voor wie we werken</h2>
        <p class="mt-5 text-lg text-muted">
          We specialiseren ons in algemene elektriciteitswerken en renovatieprojecten, nieuwbouw en domotica (vooral Niko Home Control).
          Daarnaast plaatsen we laadpalen en maken we installaties keuringsklaar volgens het AREI. Van één stopcontact tot een volledig project.
        </p>
      </div>
      <ul class="reveal-stagger mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {klanten.map((k, i) => (
          <li class="rounded-3xl border border-ink/10 bg-white p-7" style={`--i:${i}`}>
            <h3 class="font-display text-xl font-semibold">{k.titel}</h3>
            <p class="mt-2 text-muted">{k.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="werkwijze">
    <div class="container-site">
      <h2 id="werkwijze" class="h2 reveal">Hoe we werken</h2>
      <ol class="reveal-stagger mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {werkwijze.map((w, i) => (
          <li class="rounded-3xl border border-ink/10 bg-white p-7" style={`--i:${i}`}>
            <p class="font-mono text-sm font-semibold text-brand">0{i + 1}</p>
            <h3 class="mt-3 font-display text-xl font-semibold">{w.titel}</h3>
            <p class="mt-2 text-muted">{w.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-ink/10 bg-white/60" aria-labelledby="oprichter">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[20rem_1fr] lg:gap-16">
      <FotoPlaceholder label="team of werf (geen portret nodig)" class="reveal aspect-[4/5]" />
      <div class="reveal space-y-5 text-lg">
        <p class="eyebrow">Ons verhaal</p>
        <h2 id="oprichter" class="h2">Opgericht in 2018</h2>
        <p>{business.name} werd in 2018 opgericht door {business.owner}, erkend elektricien. Sindsdien is de zaak gegroeid, met projecten in Schilde en de omliggende regio.</p>
        <p><mark class="todo">[AANVULLEN: opleiding en ervaring vóór 2018 — samen ruim 10 jaar]</mark></p>
        <p>Erkend elektricien: <mark class="todo">[AANVULLEN: erkend door / waarvoor]</mark></p>
      </div>
    </div>
  </section>

  <section class="section on-ink bg-ink text-white">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Wij zoeken versterking</p>
        <h2 class="h2 mt-3">Klaar voor een nieuwe uitdaging?</h2>
        <p class="mt-5 text-lg text-on-ink-muted">Om de groei van ons bedrijf te verzekeren, zoeken we een ervaren elektricien en een junior elektricien. Ook stageplaatsen.</p>
        <a href={job.url} class="btn btn-accent mt-8">Bekijk de jobs</a>
        <p class="mt-10 text-sm text-on-ink-muted">Alle feiten op een rij: <a href="/over-ons/kerngegevens/" class="font-semibold text-white underline underline-offset-4">kerngegevens van Heeman Electrics</a>.</p>
      </div>
      <Foto id="schakelaars" class="reveal aspect-[4/3]" sizes="(min-width: 1024px) 35vw, 100vw" />
    </div>
  </section>
</Base>
