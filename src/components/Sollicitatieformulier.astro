---
// Solliciteer-formulier: Netlify Forms met honeypot (§ 4); geen reCAPTCHA-puzzel. Na verzenden → /jobs/bedankt/
// (conversie `job_apply_submit`). 03-10-2026: cv verplicht, rijbewijs B + eigen vervoer verplicht, keuze van de functie.
// Solliciteren gebeurt enkel via dit formulier (niet telefonisch). Uploads worden niet publiek bewaard.
import { business, areas } from '../data/site';
import { vacatures } from '../data/vacature';

interface Props {
  id?: string;
  /** Vooraf gekozen functie (slug uit data/vacature.ts). */
  functie?: string;
}
const { id = 'solliciteer', functie } = Astro.props;
const f = (name: string) => `${id}-${name}`;
const veld = 'mt-1.5 block w-full rounded-xl border-2 border-ink/15 bg-white px-4 py-3 text-base text-ink placeholder:text-muted/70 focus:border-brand focus:outline-none';
const label = 'block font-semibold';
const functies = [...vacatures.map((v) => ({ waarde: v.titel, slug: v.slug })), { waarde: 'Stageplaats', slug: 'stage' }];
---

<form
  name="sollicitatie"
  method="POST"
  action="/jobs/bedankt/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  enctype="multipart/form-data"
  class="sollicitatie grid gap-5 sm:grid-cols-2"
  data-event="job_apply_submit"
>
  <input type="hidden" name="form-name" value="sollicitatie" />
  <p class="hidden" aria-hidden="true"><label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="sm:col-span-2">
    <label for={f('functie')} class={label}>Ik solliciteer voor <span aria-hidden="true" class="text-brand">*</span></label>
    <select id={f('functie')} name="functie" required class={veld}>
      {functies.map((o) => <option value={o.waarde} selected={o.slug === functie}>{o.waarde}</option>)}
    </select>
  </div>
  <div class="sm:col-span-2">
    <label for={f('naam')} class={label}>Voornaam en naam <span aria-hidden="true" class="text-brand">*</span></label>
    <input id={f('naam')} name="naam" required autocomplete="name" class={veld} />
  </div>
  <div>
    <label for={f('gsm')} class={label}>Gsm <span aria-hidden="true" class="text-brand">*</span></label>
    <input id={f('gsm')} name="gsm" type="tel" required autocomplete="tel" inputmode="tel" placeholder="04.. .. .. .." class={veld} />
  </div>
  <div>
    <label for={f('email')} class={label}>E-mail <span aria-hidden="true" class="text-brand">*</span></label>
    <input id={f('email')} name="email" type="email" required autocomplete="email" class={veld} />
  </div>
  <div>
    <label for={f('woonplaats')} class={label}>Woonplaats <span aria-hidden="true" class="text-brand">*</span></label>
    <input id={f('woonplaats')} name="woonplaats" required autocomplete="address-level2" list={f('gemeenten')} class={veld} />
    <datalist id={f('gemeenten')}>{areas.map((a) => <option value={a.name} />)}</datalist>
  </div>
  <div>
    <label for={f('ervaring')} class={label}>Ervaring als elektricien <span aria-hidden="true" class="text-brand">*</span></label>
    <select id={f('ervaring')} name="ervaring" required class={veld}>
      <option value="">Kies…</option>
      <option>Net afgestudeerd of nog student</option>
      <option>Minder dan 3 jaar</option>
      <option>3 tot 5 jaar</option>
      <option>Meer dan 5 jaar</option>
    </select>
  </div>

  <div class="sm:col-span-2">
    <label for={f('cv')} class={label}>Cv <span aria-hidden="true" class="text-brand">*</span> <span class="font-normal text-muted">(pdf of docx, max. 5 MB)</span></label>
    <input id={f('cv')} name="cv" type="file" required accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class={`${veld} file:mr-4 file:rounded-full file:border-0 file:bg-ink file:px-4 file:py-2 file:font-semibold file:text-white`} data-max-mb="5" />
  </div>
  <div class="sm:col-span-2">
    <label for={f('motivatie')} class={label}>Korte motivatie <span class="font-normal text-muted">(optioneel)</span></label>
    <textarea id={f('motivatie')} name="motivatie" rows="3" class={veld} placeholder="Waarom wil je bij ons werken?"></textarea>
  </div>

  <label class="flex items-start gap-3 sm:col-span-2">
    <input type="checkbox" name="rijbewijs-b-en-vervoer" value="ja" required class="mt-1 size-5 shrink-0 accent-brand" />
    <span>Ik heb rijbewijs B en eigen vervoer. <span aria-hidden="true" class="text-brand">*</span></span>
  </label>
  <label class="flex items-start gap-3 sm:col-span-2">
    <input type="checkbox" name="privacy" required class="mt-1 size-5 shrink-0 accent-brand" />
    <span>Ik ga akkoord dat {business.name} mijn gegevens gebruikt voor deze sollicitatie, zoals beschreven in de <a href="/privacy/" class="font-semibold underline underline-offset-4">privacyverklaring</a>. <span aria-hidden="true" class="text-brand">*</span></span>
  </label>

  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button type="submit" class="btn btn-primary text-lg">Verstuur mijn sollicitatie</button>
    <p class="text-sm text-muted">* verplicht</p>
  </div>
</form>

<script>
  // Cv groter dan 5 MB: meteen melden in plaats van pas na verzenden.
  document.querySelectorAll<HTMLInputElement>('input[type=file][data-max-mb]').forEach((input) => {
    input.addEventListener('change', () => {
      const max = Number(input.dataset.maxMb) * 1024 * 1024;
      const file = input.files?.[0];
      input.setCustomValidity(file && file.size > max ? `Je cv is te groot (max. ${input.dataset.maxMb} MB).` : '');
      input.reportValidity();
    });
  });
</script>
