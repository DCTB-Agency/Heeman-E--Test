---
// Grote kabel met stekker in de hero, zoals in het logo. Tekent zich bij het laden,
// daarna loopt er een stroompuls over en geeft de stekker af en toe een vonk.
// Decoratief: aria-hidden, alleen vanaf lg zichtbaar.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const kabel = 'M 330 -20 V 120 Q 330 170 280 170 H 150 Q 100 170 100 220 V 300 Q 100 350 150 350 H 230 Q 260 350 260 380 V 402';
---

<svg class:list={['hero-kabel', className]} viewBox="0 0 400 520" fill="none" aria-hidden="true">
  <!-- Kabel -->
  <path class="draw-in" style="--dur:1.6s;--d:250ms" d={kabel} pathLength="1" stroke="var(--color-brand)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
  <!-- Stroompuls -->
  <path class="hk-puls" d={kabel} pathLength="1" stroke="#ffd2bd" stroke-width="9" stroke-linecap="round" />

  <!-- Stekker -->
  <g class="hk-stekker">
    <path d="M 222 402 H 298 V 430 A 38 38 0 0 1 222 430 Z" fill="var(--color-brand)" />
    <rect x="243" y="466" width="7" height="26" rx="3" fill="var(--color-brand)" />
    <rect x="270" y="466" width="7" height="26" rx="3" fill="var(--color-brand)" />
  </g>

  <!-- Vonken bij de pinnen -->
  <g class="hk-vonk" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round">
    <path d="M 260 505 V 518" />
    <path d="M 238 500 L 228 510" />
    <path d="M 282 500 L 292 510" />
    <path d="M 222 492 H 210" />
    <path d="M 298 492 H 310" />
  </g>
</svg>

<style>
  .hk-puls {
    display: none;
    stroke-dasharray: 0.06 1;
    filter: drop-shadow(0 0 6px #ff5a1f);
  }
  .hk-vonk {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center top;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hk-puls {
      display: block;
      animation: flow 2.8s linear 1.9s infinite both;
    }
    .hk-stekker {
      animation: fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 1.5s both;
    }
    /* Vonk telkens wanneer de puls de stekker bereikt: puls is na 94% van 2.8s aan het einde, vonk-piek zit op 8%. */
    .hk-vonk {
      animation: flicker 2.8s ease-out calc(1.9s + 2.42s) infinite;
    }
  }
</style>
