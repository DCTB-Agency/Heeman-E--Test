---
// /diensten/ — overzicht van alle diensten (CLAUDE.md § 5, § 9).
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import { SITE_URL, services, serviceUrl, business } from '../../data/site';
import { dienstTekst } from '../../data/home';
import { breadcrumbSchema } from '../../lib/schema';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Diensten', url: '/diensten/' },
];
const kern = services.filter((s) => s.priority <= 5);
const extra = services.filter((s) => s.priority > 5);

const lijstSchema = {
  '@type': 'ItemList',
  name: 'Diensten van Heeman Electrics',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE_URL}${serviceUrl(s.slug)}` })),
};
---

<Base
  title="Diensten elektricien Schilde en omgeving · Heeman"
  description="Laadpalen, keuringsklare installaties, domotica, renovatie en zonnepanelen in Schilde, Brasschaat, Zoersel en omgeving. Vraag een gratis offerte."
  schema={[lijstSchema, breadcrumbSchema(kruimels)]}
>
  <section class="container-site py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="fade-up text-muted" />
    <h1 class="mt-6 max-w-4xl text-display">
      <span class="line-mask"><span style="--i:1">Wat ik voor u</span></span>
      <span class="line-mask"><span style="--i:2">kan doen</span></span>
    </h1>
    <p class="fade-up mt-6 max-w-2xl text-lg text-muted" style="--d:350ms">
      Als erkend elektricien in Schilde werk ik voor particulieren, bedrijven en syndici in de oostrand van Antwerpen.
      Voor elke opdracht kom ik zelf langs voor het eerste bezoek en krijgt u een gratis offerte.
    </p>

    <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {kern.map((s, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={serviceUrl(s.slug)} class:list={['dienst group flex h-full flex-col rounded-3xl p-7', i === 0 ? 'on-ink bg-ink text-white' : 'border border-ink/10 bg-white hover:border-brand/40']}>
            <p class:list={['font-mono text-sm font-semibold', i === 0 ? 'text-accent' : 'text-brand']}>0{i + 1}</p>
            <h2 class="mt-3 font-display text-2xl font-semibold">{s.name}</h2>
            <p class:list={['mt-2 flex-1', i === 0 ? 'text-on-ink-muted' : 'text-muted']}>{dienstTekst[s.slug]}</p>
            <span class:list={['mt-6 inline-flex items-center gap-2 font-display font-semibold', i === 0 ? 'text-accent' : 'text-brand']}>Meer info <span class="pijl" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="h2 reveal mt-20">Ook voor</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {extra.map((s) => (
        <li class="reveal">
          <a href={serviceUrl(s.slug)} class="dienst group flex h-full flex-col rounded-3xl border border-ink/10 bg-white p-6 hover:border-brand/40">
            <h3 class="font-display text-xl font-semibold">{s.name}</h3>
            <p class="mt-2 flex-1 text-muted">{dienstTekst[s.slug]}</p>
            <span class="mt-4 inline-flex items-center gap-2 font-display font-semibold text-brand">Meer <span class="pijl" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="reveal mt-20 flex flex-col gap-6 rounded-3xl bg-accent p-8 text-ink sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-2xl font-semibold">Twijfelt u wat u nodig heeft?</p>
        <p class="mt-1">Bel of stuur een WhatsApp. Ik denk graag mee.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={business.phone.href} class="btn bg-ink text-white hover:bg-ink-soft" data-event="click_to_call">Bel {business.phone.display}</a>
        <a href={business.whatsapp.href} class="btn btn-ghost" target="_blank" rel="noopener" data-event="whatsapp_click">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dienst { transition: transform 0.25s ease, border-color 0.25s, box-shadow 0.25s; }
  .pijl { display: inline-block; transition: transform 0.3s; }
  @media (prefers-reduced-motion: no-preference) {
    .dienst:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgb(28 13 10 / 0.45); }
    .dienst:hover .pijl { transform: translateX(4px); }
  }
</style>
