---
// Groot jobs-blok op de homepage (CLAUDE.md § 6.1 + § 7.7): accentkleur, portret, "een dag met Bert".
import DagTijdlijn from './DagTijdlijn.astro';
import FotoPlaceholder from './FotoPlaceholder.astro';
import { business, job } from '../data/site';
---

<section class="section relative overflow-clip bg-accent text-ink" aria-labelledby="jobs-blok">
  <div class="container-site">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div class="reveal">
        <p class="font-display text-sm font-semibold tracking-widest uppercase">Ik zoek versterking</p>
        <h2 id="jobs-blok" class="h2 mt-3">Leer het vak van Bert.</h2>
        <p class="mt-5 max-w-2xl text-lg">
          Het werk groeit. Daarom zoek ik een <strong>junior elektricien</strong> die met mij mee op de baan gaat:
          laadpalen, Niko Home Control, zonnepanelen en renovaties in de regio Schilde. Vast, voltijds contract.
          Geen groot bedrijf, geen callcenter: jij, ik en de klant.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={job.url} class="btn bg-ink text-white hover:bg-ink-soft">Bekijk de vacature</a>
          <a href={business.whatsapp.jobHref} class="btn btn-ghost" target="_blank" rel="noopener" data-event="job_whatsapp_click">Stuur Bert een WhatsApp</a>
        </div>
      </div>
      <FotoPlaceholder label="portret van Bert op de werf" class="reveal aspect-[4/5] border-ink/30 bg-ink/5 text-ink" />
    </div>

    <div class="mt-16 border-t-2 border-ink/15 pt-10" style="--dag-bg: var(--color-accent)">
      <h3 class="font-display text-2xl font-semibold">Een dag met Bert</h3>
      <DagTijdlijn class="mt-8" />
    </div>
  </div>
</section>
