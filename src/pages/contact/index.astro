---
// /contact/ — CLAUDE.md § 5, § 9. NAP identiek aan site.ts. Geen zware Google Maps-embed: routelink.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import MailtoBevestiging from '../../components/MailtoBevestiging.astro';
import { SITE_URL, business, areas, job, antwoordTermijn } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
import { metTodo } from '../../lib/tekst';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Contact', url: '/contact/' },
];
const adres = `${business.address.street}, ${business.address.postalCode} ${business.address.locality}`;
const route = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${business.name}, ${adres}`)}`;
const contactSchema = {
  '@type': 'ContactPage',
  '@id': `${SITE_URL}/contact/#page`,
  url: `${SITE_URL}/contact/`,
  name: 'Contact Heeman Electrics',
  about: { '@id': `${SITE_URL}/#organization` },
};
const veld = 'mt-1.5 block w-full rounded-xl border-2 border-ink/15 bg-white px-4 py-3 text-base text-ink focus:border-brand focus:outline-none';
const label = 'block font-semibold';
---

<Base
  title="Contact · Heeman Electrics, elektricien Schilde"
  description={`Bel ${business.phone.display}, stuur een WhatsApp of mail ${business.email}. ${adres}.`}
  schema={[contactSchema, breadcrumbSchema(kruimels)]}
>
  <section class="container-site py-12 sm:py-16 lg:py-20">
    <Kruimels kruimels={kruimels} class="fade-up text-muted" />
    <h1 class="mt-6 text-display"><span class="line-mask"><span style="--i:1">Contact</span></span></h1>
    <p class="fade-up mt-6 max-w-2xl text-lg text-muted" style="--d:250ms">
      U spreekt rechtstreeks met mij, Bert. Bellen of WhatsApp gaat het snelst. Ik antwoord binnen <span set:html={metTodo(antwoordTermijn)} />.
    </p>

    <ul class="reveal-stagger mt-12 grid gap-4 sm:grid-cols-3">
      <li style="--i:0">
        <a href={business.phone.href} class="kanaal group flex h-full flex-col rounded-3xl bg-ink p-7 text-white" data-event="click_to_call">
          <span class="eyebrow text-accent">Bellen</span>
          <span class="mt-3 font-display text-3xl font-semibold">{business.phone.display}</span>
          <span class="mt-2 text-on-ink-muted">{business.hours.label}. {business.hours.urgent}</span>
        </a>
      </li>
      <li style="--i:1">
        <a href={business.whatsapp.href} class="kanaal group flex h-full flex-col rounded-3xl border border-ink/10 bg-white p-7" target="_blank" rel="noopener" data-event="whatsapp_click">
          <span class="eyebrow">WhatsApp</span>
          <span class="mt-3 font-display text-3xl font-semibold">Stuur een bericht</span>
          <span class="mt-2 text-muted">Handig om meteen een foto mee te sturen. <mark class="todo">[TE BEVESTIGEN: WhatsApp actief]</mark></span>
        </a>
      </li>
      <li style="--i:2">
        <a href={`mailto:${business.email}`} class="kanaal group flex h-full flex-col rounded-3xl border border-ink/10 bg-white p-7" data-event="mail_click">
          <span class="eyebrow">Mail</span>
          <span class="mt-3 font-display text-2xl font-semibold break-all sm:text-xl lg:text-2xl">{business.email}</span>
          <span class="mt-2 text-muted">Voor offertes en vragen.</span>
        </a>
      </li>
    </ul>

    <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold">Adres en gegevens</h2>
        <dl class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr]"><dt class="font-semibold">Adres</dt><dd>{business.address.street}<br />{business.address.postalCode} {business.address.locality}<br /><a href={route} class="font-semibold text-brand underline-offset-4 hover:underline" target="_blank" rel="noopener" data-event="route_click">Route plannen ↗</a></dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr]"><dt class="font-semibold">Openingsuren</dt><dd>{business.hours.label}<br />{business.hours.urgent}</dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr]"><dt class="font-semibold">Werkgebied</dt><dd>{areas.map((a) => a.name).join(', ')}</dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr]"><dt class="font-semibold">Onderneming</dt><dd set:html={metTodo(`${business.legalName} · ${business.vat}`)} /></div>
        </dl>
        <p class="mt-8 text-muted">Wil je bij mij werken? <a href={job.url} class="font-semibold text-brand underline-offset-4 hover:underline">Bekijk de vacature junior elektricien</a>.</p>
      </div>

      <div class="reveal rounded-3xl bg-white p-6 shadow-[0_24px_60px_-40px_rgb(28_13_10/0.5)] sm:p-10" data-mailto-blok>
        <h2 class="font-display text-3xl font-semibold">Stuur een bericht</h2>
        <p class="mt-2 text-muted">Voor een offerte gebruikt u best het <a href="/offerte/" class="font-semibold text-brand underline-offset-4 hover:underline">offerteformulier</a>.</p>
        <form
          name="contact"
          action={`mailto:${business.email}?subject=${encodeURIComponent('Bericht via de website')}`}
          method="post"
          enctype="text/plain"
          data-mailto={business.email}
          data-onderwerp="Bericht via de website van {naam}"
          data-event="contact_submit"
          class="mt-6 grid gap-5 sm:grid-cols-2"
        >
          <div class="sm:col-span-2">
            <label for="ct-naam" class={label}>Naam <span aria-hidden="true" class="text-brand">*</span></label>
            <input id="ct-naam" name="naam" required autocomplete="name" class={veld} />
          </div>
          <div>
            <label for="ct-gsm" class={label}>Gsm <span aria-hidden="true" class="text-brand">*</span></label>
            <input id="ct-gsm" name="gsm" type="tel" required autocomplete="tel" inputmode="tel" class={veld} />
          </div>
          <div>
            <label for="ct-email" class={label}>E-mail <span class="font-normal text-muted">(optioneel)</span></label>
            <input id="ct-email" name="email" type="email" autocomplete="email" class={veld} />
          </div>
          <div class="sm:col-span-2">
            <label for="ct-bericht" class={label}>Bericht <span aria-hidden="true" class="text-brand">*</span></label>
            <textarea id="ct-bericht" name="bericht" rows="5" required class={veld}></textarea>
          </div>
          <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
            <button type="submit" class="btn btn-primary text-lg">Verstuur</button>
            <p class="text-sm text-muted">* verplicht · <a href="/privacy/" class="underline underline-offset-4">privacy</a></p>
          </div>
        </form>
        <MailtoBevestiging />
      </div>
    </div>
  </section>
</Base>

<style>
  .kanaal { transition: transform 0.25s ease, box-shadow 0.25s, border-color 0.25s; }
  @media (prefers-reduced-motion: no-preference) {
    .kanaal:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgb(28 13 10 / 0.45); }
  }
</style>

<script>
  import '../../scripts/mailto-formulier';
</script>
