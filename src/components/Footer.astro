---
import { business, areas, services, serviceUrl, areaUrl, job } from '../data/site';
const year = new Date().getFullYear();
const isJobs = Astro.url.pathname.startsWith('/jobs/');
---

<footer class="on-ink bg-ink text-white">
  <!-- Jobs-strook boven de footer (§ 6.1) — niet op de jobpagina's zelf -->
  {!isJobs && (<div class="border-b border-white/10">
    <div class="container-site flex flex-col items-start gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-2xl font-semibold" data-stroom-vermijd>
        Werken bij Heeman Electrics? <span class="text-accent">Ik zoek een junior elektricien.</span>
      </p>
      <a href={job.url} class="btn btn-accent stopcontact-knop shrink-0 whitespace-nowrap" data-stroom-doel>
        <span class="stopcontact" aria-hidden="true"></span>
        Bekijk de vacature
      </a>
    </div>
  </div>)}

  <div class="reveal-stagger container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div style="--i:0">
      <p class="font-display text-xl font-semibold">{business.name}</p>
      <address class="mt-3 space-y-1 text-on-ink-muted not-italic">
        <p>{business.address.street}<br />{business.address.postalCode} {business.address.locality}</p>
        <p><a href={business.phone.href} class="text-white hover:text-accent" data-event="click_to_call">{business.phone.display}</a></p>
        <p><a href={`mailto:${business.email}`} class="text-white hover:text-accent">{business.email}</a></p>
      </address>
      <p class="mt-4 text-sm text-on-ink-muted">
        Open {business.hours.label}<br />
        <span class="text-white">{business.hours.urgent}</span>
      </p>
    </div>

    <div style="--i:1">
      <p class="font-display font-semibold">Diensten</p>
      <ul class="mt-3 space-y-2 text-sm text-on-ink-muted">
        {services.map((s) => <li><a href={serviceUrl(s.slug)} class="hover:text-white">{s.name}</a></li>)}
      </ul>
    </div>

    <div style="--i:2">
      <p class="font-display font-semibold">Werkgebied</p>
      <ul class="mt-3 space-y-2 text-sm text-on-ink-muted">
        {areas.map((a) => <li><a href={areaUrl(a.slug)} class="hover:text-white">Elektricien {a.name}</a></li>)}
      </ul>
    </div>

    <div style="--i:3">
      <p class="font-display font-semibold">Meer</p>
      <ul class="mt-3 space-y-2 text-sm text-on-ink-muted">
        <li><a href="/over-bert/" class="hover:text-white">Over Bert</a></li>
        <li><a href="/realisaties/" class="hover:text-white">Realisaties</a></li>
        <li><a href="/jobs/" class="font-semibold text-accent hover:text-white">Werken bij Heeman Electrics</a></li>
        <li><a href="/veelgestelde-vragen/" class="hover:text-white">Veelgestelde vragen</a></li>
        <li><a href="/kennisbank/" class="hover:text-white">Kennisbank</a></li>
        <li><a href="/offerte/" class="hover:text-white">Gratis offerte</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>

  <!-- Wettelijke vermeldingen (§ 13) -->
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-6 text-xs text-on-ink-muted sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-4">
      <p>© {year} {business.name} · {business.legalName} · Ondernemingsnummer {business.vat}</p>
      <p class="sm:ml-auto flex gap-4">
        <a href="/privacy/" class="hover:text-white">Privacy</a>
        <a href="/cookies/" class="hover:text-white">Cookies</a>
        <button type="button" class="hover:text-white" data-cookie-instellingen>Cookie-instellingen</button>
        <a href="/algemene-voorwaarden/" class="hover:text-white">Algemene voorwaarden</a>
      </p>
    </div>
  </div>
</footer>
