---
// /jobs/ — Werken bij Heeman Electrics (CLAUDE.md § 6.2). 03-10-2026: twee vacatures + stageplaatsen,
// introtekst van Heeman Electrics. Solliciteren enkel via het formulier (cv verplicht), niet telefonisch.
import Base from '../../layouts/Base.astro';
import Kruimels from '../../components/Kruimels.astro';
import Beeld from '../../components/Beeld.astro';
import { business, job, whatsappSollicitatie } from '../../data/site';
import { vacatures, vacatureUrl, jobsIntro } from '../../data/vacature';
import { breadcrumbSchema } from '../../lib/schema';

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Jobs', url: '/jobs/' },
];
const waarom = [
  { titel: 'Kennis delen', tekst: 'We werken al jaren samen met scholen in de buurt en geven blijvend trainingen op de job zelf.' },
  { titel: 'Gevarieerd werk', tekst: 'Nieuwbouw, renovatie en domotica (vooral Niko Home Control), bij particulieren en bedrijven.' },
  { titel: 'In de buurt', tekst: 'Al onze werven liggen in Schilde en de omliggende gemeenten.' },
];
---

<Base
  title="Jobs bij Heeman Electrics · Elektricien Schilde"
  description="Klaar voor een nieuwe uitdaging? Heeman Electrics zoekt een ervaren elektricien en een junior elektricien in de buurt van Schilde. Ook stageplaatsen."
  ogImage="/og/stopcontactenPlaatsing.jpg"
  schema={[breadcrumbSchema(kruimels)]}
>
  <section class="relative overflow-clip border-b border-ink/10 bg-sand/35">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-accent" aria-hidden="true"></div>
    <div class="container-site py-14 sm:py-20">
      <Kruimels kruimels={kruimels} class="fade-up text-muted" />
      <h1 class="mt-6 max-w-4xl text-display">
        <span class="line-mask"><span style="--i:1">{jobsIntro.titel}</span></span>
        <span class="line-mask"><span style="--i:2" class="text-brand">{jobsIntro.ondertitel}</span></span>
      </h1>
      <p class="fade-up mt-6 max-w-3xl text-lg text-ink/80" style="--d:400ms">{jobsIntro.tekst}</p>
      <div class="fade-up mt-8 flex flex-wrap gap-3" style="--d:500ms">
        <a href="#vacatures" class="btn btn-primary">Bekijk de vacatures</a>
        <a href={whatsappSollicitatie('elektricien')} class="btn btn-ghost" target="_blank" rel="noopener" data-event="job_whatsapp_click">Solliciteer via WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <ol class="reveal-stagger grid gap-8 md:grid-cols-3">
        {waarom.map((w, i) => (
          <li style={`--i:${i}`}>
            <p class="font-mono text-sm font-semibold text-brand">0{i + 1}</p>
            <h2 class="mt-2 font-display text-2xl font-semibold">{w.titel}</h2>
            <p class="mt-2 text-muted">{w.tekst}</p>
          </li>
        ))}
      </ol>

      <h2 id="vacatures" class="h2 reveal mt-24 scroll-mt-24">Open vacatures</h2>
      <ul class="mt-8 grid gap-6">
        {vacatures.map((v) => (
          <li class="reveal">
            <a href={vacatureUrl(v.slug)} class="vacature-kaart group grid gap-6 rounded-3xl bg-ink p-6 text-white sm:grid-cols-[14rem_1fr] sm:p-8">
              <Beeld beeld={v.kaart} donker class="aspect-square sm:aspect-auto sm:min-h-56" sizes="(min-width: 640px) 14rem, 100vw" />
              <div class="flex flex-col justify-center">
                <p class="eyebrow text-accent">Voltijds · in de buurt van Schilde</p>
                <h3 class="mt-2 font-display text-3xl font-semibold">{v.titel}</h3>
                <p class="mt-3 max-w-2xl text-on-ink-muted">{v.kort}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-display font-semibold text-accent">Bekijk de vacature <span class="pijl" aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="reveal mt-16 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-ink/10 bg-white p-8">
          <h2 class="font-display text-2xl font-semibold">Op zoek naar een stageplaats?</h2>
          <p class="mt-2 text-muted">We werken al jaren samen met scholen in de buurt. Kies "Stageplaats" in het sollicitatieformulier, of stuur een WhatsApp.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={`${vacatureUrl('junior-elektricien')}#solliciteer`} class="btn btn-primary">Solliciteer voor een stage</a>
            <a href={whatsappSollicitatie('stagiair')} class="btn btn-ghost" target="_blank" rel="noopener" data-event="job_whatsapp_click">WhatsApp</a>
          </div>
        </div>
        <div class="rounded-3xl border border-ink/10 bg-white p-8">
          <h2 class="font-display text-2xl font-semibold">Geen passende vacature?</h2>
          <p class="mt-2 text-muted">Stuur gerust een spontane sollicitatie met je cv, via WhatsApp of naar {business.email}.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={whatsappSollicitatie('elektricien')} class="btn btn-primary" target="_blank" rel="noopener" data-event="job_whatsapp_click">WhatsApp</a>
            <a href={job.mailto} class="btn btn-ghost">Mail je cv</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .vacature-kaart { transition: transform 0.25s ease, box-shadow 0.25s; }
  .pijl { display: inline-block; transition: transform 0.3s; }
  @media (prefers-reduced-motion: no-preference) {
    .vacature-kaart:hover { transform: translateY(-4px); box-shadow: 0 24px 50px -28px rgb(28 13 10 / 0.6); }
    .vacature-kaart:hover .pijl { transform: translateX(4px); }
  }
</style>
